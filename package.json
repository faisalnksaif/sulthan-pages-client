{
  "name": "sulthan-pages-client",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "predeploy": "npm run build && echo 'sulthanpages.com' > dist/CNAME",
    "deploy": "npm run predeploy && gh-pages -d dist"
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@fontsource/roboto": "5.2.6",
    "@keystone-6/document-renderer": "^1.1.2",
    "@mdi/font": "7.4.47",
    "@vue/apollo-composable": "^4.2.2",
    "graphql": "^16.11.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "vuetify": "^3.9.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@types/graphql": "^14.5.0",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.30.1",
    "eslint-config-vuetify": "^4.0.0",
    "gh-pages": "^6.3.0",
    "npm-run-all2": "^7.0.2",
    "sass-embedded": "^1.89.2",
    "typescript": "~5.8.3",
    "unplugin-fonts": "^1.3.1",
    "unplugin-vue-components": "^28.8.0",
    "unplugin-vue-router": "^0.14.0",
    "vite": "^6.3.5",
    "vite-plugin-vuetify": "^2.1.1",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.0.1"
  }
}
